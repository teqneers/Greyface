{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022", "dom", "dom.iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "allowJs": false,
        "useDefineForClassFields": true,
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["assets/js/*"]
        }
    },
    "include": ["assets/js/**/*"]
}

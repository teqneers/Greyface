{% extends 'base.html.twig' %}
{% set pageId = pageId|default("page") %}

{% block title %}{% block subtitle %}{% endblock %} | greyface{% endblock %}

{% block stylesheets %}
    {{ vite_entry_link_tags('page') }}
{% endblock %}

{% block javascripts %}
    {{ vite_entry_script_tags('page') }}
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
                <div id="{{ pageId }}">
                    {% block content %}{% endblock %}
                </div>
                <div id="copyright" class="mt-5 text-center">
                    <a href="https://www.teqneers.de/" target="_blank">©{{ "now"|date('Y') }} TEQneers GmbH & Co. KG</a>
                </div>
        </div>
    </div>
{% endblock %}

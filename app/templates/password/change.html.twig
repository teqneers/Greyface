{% extends 'page.html.twig' %}

{% block subtitle %}{% trans %}change_password.title{% endtrans %}{% endblock %}

{% block content %}
    <h1 class="text-xl font-semibold tracking-tight">{% trans %}change_password.header{% endtrans %}</h1>
    <p class="mt-1 text-sm text-muted-foreground">{% trans %}change_password.intro{% endtrans %}</p>

    {{ form_start(form, {attr: {class: 'mt-6 space-y-4'}}) }}
    {{ form_errors(form) }}

    <div class="space-y-1.5">
        <label for="username" class="gf-label">{% trans %}change_password.form.username{% endtrans %}</label>
        <input class="gf-input" type="text" disabled id="username" value="{{ user.username }}" autocomplete="username"/>
    </div>

    {{ form_rest(form) }}

    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-end">
        <a href="{{ path('app') }}" class="gf-button-outline">{% trans %}cancel{% endtrans %}</a>
        <button type="submit" class="gf-button-primary">{% trans %}change_password.submit{% endtrans %}</button>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% extends 'page.html.twig' %}

{% block subtitle %}{% trans %}login.title{% endtrans %}{% endblock %}

{% block content %}
    <h1 class="text-xl font-semibold tracking-tight">{% trans %}login.header{% endtrans %}</h1>
    <p class="mt-1 text-sm text-muted-foreground">{% trans %}login.intro{% endtrans %}</p>

    {% if error %}
        <div role="alert" class="mt-4 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form name="login" method="post" action="{{ path('login') }}" class="mt-6 space-y-4">
        <div class="space-y-1.5">
            <label for="username" class="gf-label">{% trans %}login.form.username{% endtrans %}</label>
            <input class="gf-input" type="text" id="username" name="username"
                   value="{{ last_username }}"
                   required autocomplete="username" {% if not last_username %}autofocus{% endif %}/>
        </div>

        <div class="space-y-1.5">
            <label for="password" class="gf-label">{% trans %}login.form.password{% endtrans %}</label>
            <input class="gf-input" type="password" id="password" name="password"
                   required autocomplete="current-password" {% if last_username %}autofocus{% endif %}/>
        </div>

        <label class="flex items-center gap-2 text-sm" for="remember_me">
            <input type="checkbox" class="gf-checkbox" id="remember_me" name="remember_me"/>
            {% trans %}login.form.remember_me{% endtrans %}
        </label>

        <input type="hidden" name="csrf_token" value="{{ csrf_token('login') }}"/>

        <button type="submit" class="gf-button-primary w-full">{% trans %}login.submit{% endtrans %}</button>
    </form>
{% endblock %}

# Caddy configuration for the production image.
#
# One knob decides how Greyface is served:
#
#   SERVER_NAME unset          plain HTTP on port 80. This is the default because
#                              most deployments sit behind an existing reverse
#                              proxy, ingress or load balancer that already holds
#                              the certificate. Set TRUSTED_PROXIES when you do.
#
#   SERVER_NAME=mail.example   Caddy obtains a certificate for that name, serves
#                              HTTPS on 443 and redirects 80 to it. Needs both
#                              ports published, outbound network access, and a
#                              volume on /data so certificates survive restarts.
{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp

	# php_server has to win over the static file server, otherwise index.php is
	# offered as a download instead of executed.
	order php_server before file_server
}

{$SERVER_NAME::80} {
	root {$SERVER_ROOT:/srv/greyface/app/public}

	encode zstd br gzip

	# The frontend bundles carry a content hash in their filename, so they can be
	# cached indefinitely. Everything else is served fresh.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server {
		# Symfony routes everything that is not a real file through index.php.
		try_files {path} index.php
	}
}

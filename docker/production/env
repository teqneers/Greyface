# Shipped as the .env of both the production image and the release archive.
#
# Symfony's Dotenv requires this file to exist, so it does, but it holds no
# configuration and you should not edit it.
#
# Put your own settings somewhere they survive an upgrade instead:
#   container  the environment (-e DATABASE_URL=..., or compose `environment:`)
#   archive    a .env.local file next to this one
#
# Both override what is written here. greyface:check-config refuses to start if
# the important ones are missing, so a misconfigured install fails immediately
# and says why.
APP_ENV=prod
